# Copia este archivo como backend/.env y completa los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

# --- Django ---
DJANGO_DEBUG=True
# En producción genera una clave larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
# Hosts separados por coma. En Render agrega el dominio del servicio (ej. pos-papel-y-luna.onrender.com).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Orígenes con https:// que pueden usar el admin de Django (solo producción).
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_papel_luna
# Pon True si la base de datos en la nube exige SSL (Neon, Render, Supabase...).
DB_SSL_REQUIRE=False

# --- CORS: orígenes del frontend, separados por coma, sin "/" final ---
# Desarrollo (Live Server / python -m http.server) + frontend desplegado.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=8

# --- Reglas del POS ---
# Los precios de los productos YA incluyen IVA. Este porcentaje solo se usa para
# mostrar en la factura cuánto IVA hay dentro del total (no se suma al total).
POS_IVA_PORCENTAJE=19

# --- Usuarios iniciales (los usa: python manage.py crear_usuarios_iniciales) ---
POS_ADMIN_USERNAME=admin
POS_ADMIN_PASSWORD=Admin.PyL2026
POS_CAJERO_USERNAME=cajero
POS_CAJERO_PASSWORD=Cajero.PyL2026

# --- Solo en Render: True carga un catálogo de ejemplo durante el build ---
POS_CARGAR_DEMO=False

# --- Alertas de vencimiento (días) ---
POS_DIAS_ALERTA_VENCIMIENTO=15
